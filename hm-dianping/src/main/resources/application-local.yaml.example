# ============================================================
# 本地私有配置模板
# 用法：把本文件复制为同目录下的 application-local.yaml，并填入真实密码。
# application-local.yaml 已被 .gitignore 忽略，不会被提交到 GitHub。
# ============================================================
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/ikun?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
    username: root
    password: 这里填写MySQL密码
  redis:
    host: 192.168.234.128
    port: 6379
    password: 这里填写Redis密码

hmdp:
  # 改成你自己 Nginx 站点 html/hmdp/imgs 的绝对路径（注意用正斜杠 /）
  upload-dir: D:/mongdb/nginx/nginx-1.18.0/html/hmdp/imgs/
